{
  "name": "backend",
  "version": "1.0.0",
  "description": "Token based authentication backend with Express and MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "npm install --prefix ../Frontend && npm run build --prefix ../Frontend",
    "seed": "node --env-file=.env src/seeds/seed.js"
  },
  "keywords": [
    "express",
    "mongoose",
    "authentication",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
